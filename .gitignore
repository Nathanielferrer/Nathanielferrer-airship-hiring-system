# ── Airship Express Hiring System — Root .gitignore ──────────────
# Protect sensitive files, credentials, uploaded documents, and build artifacts

# 1. Environment Secrets (CRITICAL: Never commit to Git)
*.env
*.env.local
*.env.*.local
!backend/.env.example
!frontend/.env.example

# 2. Uploaded Candidate Files & Resumes (Privacy Protection)
backend/uploads/*
!backend/uploads/templates/
backend/uploads/templates/*
!backend/uploads/templates/template_info.json
backend/private/
backend/private/resumes/
backend/cache/

# 3. Dependencies & Binaries
backend/composer.phar
frontend/node_modules/
backend/vendor/

# 4. Frontend Build Output
frontend/dist/
frontend/dist-ssr/

# 5. Logs & Temporary Debug Files
*.log
error_log
*email_log.txt
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 6. OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
scratch/

