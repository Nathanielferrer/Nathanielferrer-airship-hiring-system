# ── Airship Express Hiring System — Environment Configuration ──────────────
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control!

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=hiring_db

# Cryptographic Token Signing Key (use a long random string in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
JWT_EXPIRY_SECONDS=86400

# Google Gemini AI API Keys (comma-separated for multi-key failover)
GEMINI_API_KEYS=YOUR_PRIMARY_KEY,YOUR_BACKUP_KEY_2,YOUR_BACKUP_KEY_3

# Gmail SMTP Notification Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Domain & CORS Configuration (Railway Production)
# ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=https://hiring.yourdomain.com
# FRONTEND_URL: Used in emails for action links (verify, login, reset password)
FRONTEND_URL=https://hiring.yourdomain.com
# BACKEND_URL: Used in emails for PDF / file download links
BACKEND_URL=https://api.hiring.yourdomain.com
